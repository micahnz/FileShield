[Unit]
Description=Fileshield - file access interceptor
Documentation=https://github.com/yoransys/fileshield
After=multi-user.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/fileshield --foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Display settings are auto-detected from /run/user/ at runtime (Wayland and X11).
# Override here only if auto-detection fails in your setup:
# Environment=WAYLAND_DISPLAY=wayland-1
# Environment=DISPLAY=:0

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=fileshield
StateDirectoryMode=0700
UMask=0077
RestrictSUIDSGID=yes
ProtectProc=invisible
# ProtectHome cannot be enabled: the daemon resolves protected paths inside
# the service's mount namespace, and ProtectHome=yes substitutes empty shadow
# directories there, so marks would target shadow inodes instead of the real
# files.  Mount-namespace sandboxing in general is fine (ProtectSystem=,
# ProtectProc=): the daemon marks the filesystem superblock
# (FAN_MARK_FILESYSTEM), which is shared across mount namespaces, and only
# falls back to namespace-local mount marks where the kernel or filesystem
# does not support it.
#
# PrivateTmp cannot be enabled either: it hides /tmp/.X11-unix from the
# dialog child on X11 desktops, and the daemon never uses /tmp itself.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service rseq fanotify_init fanotify_mark setuid setgid setresuid setresgid
SystemCallArchitectures=native

# fanotify requires CAP_SYS_ADMIN; /proc/<pid>/exe requires CAP_SYS_PTRACE;
# CAP_DAC_READ_SEARCH is required to traverse home directories with mode 750
# (e.g. /home/user drwxr-x--- ) so that fanotify_mark can resolve their paths.
# CAP_SETUID + CAP_SETGID are required to drop to the desktop user before
# spawning kdialog (session sockets are mode 0600, owner=user).
# CAP_KILL is required to terminate a hung dialog after the outer timeout;
# the dialog child has already dropped to the desktop UID by then.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL

[Install]
WantedBy=multi-user.target
