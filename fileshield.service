[Unit]
Description=Fileshield - file access interceptor
Documentation=https://github.com/yoransys/fileshield
After=multi-user.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/fileshield --foreground
ExecReload=/bin/kill -HUP $MAINPID
# Restart on every unattended termination — a protection daemon must not
# silently stay down after a clean-looking internal exit.  A manual
# `systemctl stop` still stays stopped.
Restart=always
RestartSec=5

# The Wayland session is auto-detected from /run/user/ at runtime.  X11 is
# not auto-detected: set DISPLAY here for X11 desktops.  XDG_RUNTIME_DIR is
# deliberately not set here (systemd does not provide it to services): the
# daemon derives the runtime dir and bus address from the requesting
# process's uid in that case, so prompts still reach the right user.
# Environment=WAYLAND_DISPLAY=wayland-1
# Environment=DISPLAY=:0

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=fileshield
StateDirectoryMode=0700
UMask=0077
RestrictSUIDSGID=yes
ProtectProc=invisible
# Mount marks are attached to the init-namespace mounts through
# /proc/1/root, so the mount-namespace sandboxing below (ProtectSystem=,
# ProtectProc=, PrivateDevices=) does not blind them: the marks live on
# the mounts user processes open through, not on the service's copies.
# Do not enable ProtectHome=yes: it substitutes empty shadow directories
# and the daemon resolves protected paths from the real tree.
# Do not enable PrivateTmp=yes: it hides /tmp/.X11-unix from the dialog
# child on X11 desktops, and the daemon never uses /tmp itself.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
# AF_UNIX only: the daemon and kdialog/notify-send need no network sockets.
# NOTE: Qt/kdialog sometimes opens an AF_NETLINK (route) socket at startup;
# if a prompt ever fails to appear on a specific desktop, that filter is
# the first suspect (a failed prompt denies access — fail closed, not a
# security hole).
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service rseq fanotify_init fanotify_mark setuid setgid setresuid setresgid
SystemCallFilter=~@mount
SystemCallArchitectures=native

# fanotify requires CAP_SYS_ADMIN; /proc/<pid>/exe and the /proc/1/root
# mount-mark paths require CAP_SYS_PTRACE;
# CAP_DAC_READ_SEARCH is required to traverse home directories with mode 750
# (e.g. /home/user drwxr-x--- ) so that fanotify_mark can resolve their paths.
# CAP_SETUID + CAP_SETGID are required to drop to the desktop user before
# spawning kdialog (session sockets are mode 0600, owner=user).
# CAP_KILL is required to terminate a hung dialog after the outer timeout;
# the dialog child has already dropped to the desktop UID by then.
#
# ProtectProc=invisible + CAP_SYS_PTRACE are a coupled pair: identity
# gathering reads /proc/<pid>/{exe,stat,environ,cmdline} of OTHER users'
# processes, which pidfs visibility checks permit only because the
# ambient CAP_SYS_PTRACE satisfies them.  If the capability set is ever
# trimmed, every prompt fails (fail closed) — verify with a root smoke
# test of a full prompt cycle whenever the unit or capability set changes.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL

[Install]
WantedBy=multi-user.target
